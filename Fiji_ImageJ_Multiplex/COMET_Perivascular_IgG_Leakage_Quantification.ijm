/*
 * COMET perivascular IgG leakage analysis
 * Version 1.1.4 (2026-10-06)
 * Requires Fiji/ImageJ 1.54a or later.
 *
 * PURPOSE
 *   Quantify extravascular IgG around each previously QC-approved vascular
 *   profile generated by COMET vessel-profile multi-marker analysis v2.0.2.
 *
 * IMPORTANT GEOMETRY
 *   - The input V#### vessel ROIs are not re-segmented or renumbered.
 *   - Each vessel ROI is converted temporarily to its hole-filled outer
 *     profile before the perivascular band is constructed. This prevents a
 *     lumen from being mistaken for extravascular tissue.
 *   - The final perivascular ROI is a vessel-shape-matched band, not a circle.
 *   - All filled vascular profiles (including their lumens) are removed from
 *     every perivascular band. This prevents a nearby vessel from contributing
 *     intravascular IgG to the measurement.
 *   - A user-drawn DAPI tumor ROI confines the analysis. A vessel is assigned
 *     to tumor only when its centroid lies inside that ROI, and its final
 *     perivascular band is intersected with the tumor ROI.
 *   - Bands clipped by the tumor boundary are explicitly flagged and can be
 *     excluded from leaky/non-leaky classification.
 *   - Perivascular bands from nearby vessels can still overlap each other.
 *     Therefore the same extravascular pixels may contribute to more than one
 *     vessel when vessels are closely spaced. Interpret clustered vessels
 *     cautiously and report the selected band distance.
 *   - A lumen can be filled only when it is enclosed by the source ROI. An
 *     open/discontinuous vascular wall does not provide enough 2D geometry to
 *     infer its lumen and must be handled during biological QC.
 *
 * LEAKAGE CLASSIFICATION
 *   The macro can either measure IgG without classification or classify a
 *   vessel using BOTH:
 *     1. a fixed raw IgG-positive intensity threshold; and
 *     2. a minimum percentage of IgG-positive pixels in the perivascular ROI.
 *
 *   Do not derive a separate cutoff from each experimental image. Establish
 *   the fixed intensity threshold and positive-area-fraction cutoff from
 *   appropriate negative/control tissue acquired and processed identically,
 *   then apply the same values to the complete cohort.
 *
 * REQUIRED INPUTS
 *   1. Original single-channel grayscale vessel-marker image (e.g. CD31).
 *   2. Matching original single-channel grayscale IgG image.
 *   3. Matching original single-channel grayscale DAPI image.
 *   4. Matching final 8-bit vessel binary mask from the original macro.
 *   5. Matching <ID>_Vessel_ROIs.zip from the original macro.
 *
 *   All four images must be open, single-plane, identically aligned and
 *   spatially calibrated. Do not use RGB composites, JPEGs, screenshots or
 *   the flattened Vessel_ID_map for measurement.
 *
 * OUTPUTS
 *   <ID>_Perivascular_IgG_measurements.csv
 *   <ID>_Perivascular_IgG_ROIs.zip
 *   <ID>_Filled_vessel_exclusion_mask.tif
 *   <ID>_Tumor_ROI.roi
 *   <ID>_Tumor_mask.tif
 *   <ID>_Perivascular_IgG_settings.txt
 *   <ID>_Leaky_vessel_IDs.txt             (classification mode only)
 *   <ID>_Nonleaky_vessel_IDs.txt          (classification mode only)
 *   <ID>_Excluded_vessel_IDs.txt          (classification mode only)
 */

requires("1.54a");

if (nImages < 4)
    exit("Open the matched vessel-marker, IgG, DAPI and final vessel binary mask images before running this macro.");

titles = getList("image.titles");
classificationModes = newArray(
    "Measure only (no leaky/non-leaky label)",
    "Classify using fixed IgG threshold + positive-area fraction"
);

Dialog.create("Perivascular IgG analysis inputs");
Dialog.addMessage("Select the original matched grayscale images and the final vessel mask generated by the vessel-analysis macro.");
Dialog.addChoice("Vessel-marker image", titles, titles[0]);
Dialog.addChoice("IgG image", titles, titles[1]);
Dialog.addChoice("DAPI image for drawing tumor ROI", titles, titles[2]);
Dialog.addChoice("Final vessel binary mask", titles, titles[3]);
Dialog.addString("Sample/ROI ID", "Sample01_ROI01", 24);
Dialog.addNumber("Full-resolution crop origin X (pixels)", 0);
Dialog.addNumber("Full-resolution crop origin Y (pixels)", 0);
Dialog.show();

vesselImageTitle = Dialog.getChoice();
iggImageTitle = Dialog.getChoice();
dapiImageTitle = Dialog.getChoice();
vesselMaskTitle = Dialog.getChoice();
sampleID = String.trim(Dialog.getString());
cropX = Dialog.getNumber();
cropY = Dialog.getNumber();

if (sampleID == "")
    exit("A Sample/ROI ID is required.");
if (cropX < 0 || cropY < 0)
    exit("Crop origin X and Y cannot be negative.");
if (vesselImageTitle == iggImageTitle || vesselImageTitle == dapiImageTitle || vesselImageTitle == vesselMaskTitle ||
    iggImageTitle == dapiImageTitle || iggImageTitle == vesselMaskTitle || dapiImageTitle == vesselMaskTitle)
    exit("Select four different image windows: vessel marker, IgG, DAPI and vessel binary mask.");

// Validate image dimensions, planes, bit depth and calibration.
selectedTitles = newArray(vesselImageTitle, iggImageTitle, dapiImageTitle, vesselMaskTitle);
// Bio-Formats and TIFF can store the same calibration with tiny floating-point
// rounding differences. Compare using a stringent relative tolerance, while
// still stopping for a biologically meaningful scale mismatch.
calRelativeTolerance = 0.00001;
for (k = 0; k < 4; k++) {
    selectWindow(selectedTitles[k]);
    getDimensions(tmpW, tmpH, tmpC, tmpZ, tmpT);
    tmpBD = bitDepth();
    getPixelSize(tmpUnit, tmpPW, tmpPH);
    tmpNormalizedUnit = normalizeLengthUnit(tmpUnit);

    if (tmpC != 1 || tmpZ != 1 || tmpT != 1)
        exit("'" + selectedTitles[k] + "' is not a single-channel, single-Z, single-time-point image.");
    if (tmpBD == 24)
        exit("'" + selectedTitles[k] + "' is flattened RGB. Use the original grayscale channel or binary-mask image.");

    if (k == 0) {
        imageWidth = tmpW;
        imageHeight = tmpH;
        lengthUnit = tmpUnit;
        normalizedLengthUnit = tmpNormalizedUnit;
        pixelWidth = tmpPW;
        pixelHeight = tmpPH;
        vesselBitDepth = tmpBD;
    } else {
        if (tmpW != imageWidth || tmpH != imageHeight)
            exit("The vessel-marker, IgG, DAPI and binary-mask images do not have identical pixel dimensions.");
        widthTolerance = calRelativeTolerance * maxOf(abs(pixelWidth), abs(tmpPW));
        heightTolerance = calRelativeTolerance * maxOf(abs(pixelHeight), abs(tmpPH));
        if (widthTolerance < 1e-9)
            widthTolerance = 1e-9;
        if (heightTolerance < 1e-9)
            heightTolerance = 1e-9;
        if (tmpNormalizedUnit != normalizedLengthUnit || abs(tmpPW - pixelWidth) > widthTolerance || abs(tmpPH - pixelHeight) > heightTolerance)
            exit("Spatial calibration genuinely differs between the selected images.\n\n" +
                "Reference vessel-marker image:\n" + vesselImageTitle + "\n" +
                "Pixel width=" + pixelWidth + ", pixel height=" + pixelHeight + ", unit=" + lengthUnit + "\n\n" +
                "Mismatched image:\n" + selectedTitles[k] + "\n" +
                "Pixel width=" + tmpPW + ", pixel height=" + tmpPH + ", unit=" + tmpUnit + "\n\n" +
                "If these are known matching, pixel-aligned channels, use Image > Properties to assign the exact vessel-marker pixel width, height and unit to the mismatched image. Do not resize it.");
        if (k == 1)
            iggBitDepth = tmpBD;
        if (k == 2)
            dapiBitDepth = tmpBD;
    }
}

if (pixelWidth <= 0 || pixelHeight <= 0)
    exit("Invalid spatial calibration. Pixel width and height must be greater than zero.");
squarePixelTolerance = calRelativeTolerance * maxOf(abs(pixelWidth), abs(pixelHeight));
if (squarePixelTolerance < 1e-9)
    squarePixelTolerance = 1e-9;
if (abs(pixelWidth - pixelHeight) > squarePixelTolerance)
    exit("This macro requires square pixels so that the perivascular distance is isotropic. Current pixel width=" + pixelWidth + " and height=" + pixelHeight + ".");
if (normalizedLengthUnit == "pixel")
    exit("The images are not spatially calibrated. Set the correct physical pixel size before defining a perivascular distance.");

selectWindow(vesselMaskTitle);
if (bitDepth() != 8)
    exit("The final vessel binary mask must be 8-bit.");
run("Select None");
getHistogram(maskValues, maskCounts, 256);
if (maskCounts[255] == 0)
    exit("The selected vessel mask contains no white (255) vessel pixels.");
for (v = 1; v < 255; v++) {
    if (maskCounts[v] > 0)
        exit("The selected vessel mask is not binary. It contains values other than 0 and 255.");
}

Dialog.create("Perivascular IgG settings");
Dialog.addNumber("Inner gap from filled vessel boundary", 0, 2, 8, lengthUnit);
Dialog.addNumber("Outer distance from filled vessel boundary", 20, 2, 8, lengthUnit);
Dialog.addCheckbox("Measure pooled IgG background from user-drawn ROIs", true);
Dialog.addNumber("Number of IgG background ROIs", 3);
Dialog.addNumber("Minimum analyzable perivascular area", 20, 2, 8, lengthUnit + "^2");
Dialog.addCheckbox("Exclude edge-truncated perivascular ROIs from classification", true);
Dialog.addCheckbox("Exclude tumor-boundary-truncated perivascular ROIs from classification", true);
Dialog.addChoice("Leakage classification", classificationModes, classificationModes[0]);
Dialog.addNumber("Fixed IgG-positive threshold (raw intensity; classification mode only)", 0);
Dialog.addNumber("Minimum IgG-positive area fraction for 'Leaky'", 5, 2, 8, "%");
Dialog.addMessage("The fixed IgG threshold and area-fraction cutoff must be established from appropriate controls and applied unchanged to all samples.");
Dialog.show();

innerDistance = Dialog.getNumber();
outerDistance = Dialog.getNumber();
measureBackground = Dialog.getCheckbox();
nBackgroundROIs = round(Dialog.getNumber());
minAnalyzableArea = Dialog.getNumber();
excludeEdgeFromClassification = Dialog.getCheckbox();
excludeTumorBoundaryFromClassification = Dialog.getCheckbox();
classificationMode = Dialog.getChoice();
iggPositiveThreshold = Dialog.getNumber();
positiveFractionCutoff = Dialog.getNumber();

classifyLeakage = false;
if (classificationMode == classificationModes[1])
    classifyLeakage = true;

if (innerDistance < 0 || outerDistance <= 0 || outerDistance <= innerDistance)
    exit("Outer distance must be greater than the non-negative inner gap.");
if (minAnalyzableArea < 0)
    exit("Minimum analyzable perivascular area cannot be negative.");
if (measureBackground && nBackgroundROIs < 1)
    exit("Use at least one background ROI, or disable background measurement.");
if (classifyLeakage) {
    if (iggPositiveThreshold <= 0)
        exit("Classification requires a fixed raw IgG-positive threshold greater than zero.");
    if (positiveFractionCutoff < 0 || positiveFractionCutoff > 100)
        exit("The IgG-positive area-fraction cutoff must be between 0 and 100 percent.");
}

innerPixels = round(innerDistance / pixelWidth);
outerPixels = round(outerDistance / pixelWidth);
bandPixels = outerPixels - innerPixels;
if (outerPixels < 1 || bandPixels < 1)
    exit("The selected physical distances round to an invalid band at the current pixel size.");
if (bandPixels > 255)
    exit("The perivascular band width is " + bandPixels + " pixels. ImageJ's Make Band command supports at most 255 pixels. Reduce the outer distance or increase the inner gap.");

actualInnerDistance = innerPixels * pixelWidth;
actualOuterDistance = outerPixels * pixelWidth;

roiZipPath = File.openDialog("Select the matching Vessel_ROIs.zip file");
if (roiZipPath == "")
    exit("No vessel ROI ZIP was selected.");
if (indexOf(toLowerCase(roiZipPath), ".zip") < 0)
    exit("Select the ZIP archive generated as <ID>_Vessel_ROIs.zip by the vessel-analysis macro.");

outputDir = getDirectory("Choose output folder");
if (outputDir == "")
    exit("No output folder was selected.");

safeID = safeLabel(sampleID);
resultsPath = outputDir + safeID + "_Perivascular_IgG_measurements.csv";
ringRoiPath = outputDir + safeID + "_Perivascular_IgG_ROIs.zip";
filledMaskPath = outputDir + safeID + "_Filled_vessel_exclusion_mask.tif";
tumorRoiPath = outputDir + safeID + "_Tumor_ROI.roi";
tumorMaskPath = outputDir + safeID + "_Tumor_mask.tif";
settingsPath = outputDir + safeID + "_Perivascular_IgG_settings.txt";
leakyIDsPath = outputDir + safeID + "_Leaky_vessel_IDs.txt";
nonleakyIDsPath = outputDir + safeID + "_Nonleaky_vessel_IDs.txt";
excludedIDsPath = outputDir + safeID + "_Excluded_vessel_IDs.txt";

outputExists = false;
if (File.exists(resultsPath))
    outputExists = true;
if (File.exists(ringRoiPath))
    outputExists = true;
if (File.exists(filledMaskPath))
    outputExists = true;
if (File.exists(tumorRoiPath))
    outputExists = true;
if (File.exists(tumorMaskPath))
    outputExists = true;
if (File.exists(settingsPath))
    outputExists = true;
if (classifyLeakage && File.exists(leakyIDsPath))
    outputExists = true;
if (classifyLeakage && File.exists(nonleakyIDsPath))
    outputExists = true;
if (classifyLeakage && File.exists(excludedIDsPath))
    outputExists = true;
if (outputExists) {
    overwriteOK = getBoolean("One or more perivascular IgG outputs for '" + safeID + "' already exist. Overwrite them?", "Overwrite", "Cancel");
    if (!overwriteOK)
        exit("Analysis cancelled. Use a different Sample/ROI ID or output folder.");
}

for (k = 0; k < 4; k++) {
    selectWindow(selectedTitles[k]);
    run("Select None");
}

// Load the exact QC-approved vessel ROIs and preserve the original V#### IDs.
existingROIs = roiManager("count");
if (existingROIs > 0) {
    clearOK = getBoolean("ROI Manager contains " + existingROIs + " ROI(s). They must be cleared to load the vessel ROI ZIP.", "Clear and continue", "Cancel");
    if (!clearOK)
        exit("Analysis cancelled without changing the existing ROI list.");
}
roiManager("reset");
roiManager("open", roiZipPath);
nVessels = roiManager("count");
if (nVessels == 0)
    exit("The selected ROI ZIP contains no vessel ROIs.");

vesselIDs = newArray(nVessels);
centroidXs = newArray(nVessels);
centroidYs = newArray(nVessels);
ringIndexes = newArray(nVessels);
filledProfilePixels = newArray(nVessels);
leakStatuses = newArray(nVessels);
qcStatuses = newArray(nVessels);

// Validate ROI type, expected stable ID order, and agreement with the saved mask.
for (i = 0; i < nVessels; i++) {
    vesselID = RoiManager.getName(i);
    expectedID = "V" + IJ.pad(i + 1, 4);
    if (vesselID != expectedID)
        exit("ROI " + (i + 1) + " is named '" + vesselID + "' but the matching stable ID should be '" + expectedID + "'. Select the original unmodified Vessel_ROIs.zip.");

    selectWindow(vesselImageTitle);
    roiManager("select", i);
    st = selectionType;
    if (st < 0 || (st >= 5 && st <= 8) || st == 10)
        exit("Vessel ROI " + vesselID + " is not an area ROI.");

    selectWindow(vesselMaskTitle);
    roiManager("select", i);
    getRawStatistics(checkN, checkMean, checkMin, checkMax);
    if (checkN <= 0 || checkMin != 255 || checkMax != 255)
        exit("Vessel ROI " + vesselID + " does not match the selected final vessel binary mask. Confirm that the image crop, mask and ROI ZIP come from the same completed analysis.");

    vesselIDs[i] = vesselID;
    ringIndexes[i] = -1;
    leakStatuses[i] = "Not_classified";
    qcStatuses[i] = "Pending";
}

// Define one tumor area on the matching DAPI image. The ROI is appended after
// the original V#### ROIs so the vessel indices remain unchanged.
selectWindow(dapiImageTitle);
run("Select None");
setTool("freehand");
waitForUser("Define the DAPI tumor ROI",
    "On the ORIGINAL DAPI image, draw one area ROI around the tumor.\n\n" +
    "Use the polygon or freehand selection tool and follow the tumor boundary.\n" +
    "Exclude non-tumor tissue, tissue-free space and folds/tears.\n" +
    "A composite area selection is allowed when needed.\n\n" +
    "Click OK here only after the yellow tumor outline is complete.");

tumorSelectionType = selectionType;
if (tumorSelectionType < 0 || (tumorSelectionType >= 5 && tumorSelectionType <= 8) || tumorSelectionType == 10)
    exit("The DAPI tumor selection must be an area ROI, not a line or point selection.");
getRawStatistics(tumorPixels);
if (tumorPixels <= 0)
    exit("The DAPI tumor ROI contains no pixels.");
tumorAreaCalibrated = tumorPixels * pixelWidth * pixelHeight;
getSelectionBounds(tumorBoxX, tumorBoxY, tumorBoxW, tumorBoxH);

roiManager("add");
tumorIndex = nVessels;
roiManager("select", tumorIndex);
roiManager("rename", "Tumor_ROI");
roiManager("save selected", tumorRoiPath);

selectWindow(dapiImageTitle);
dapiImageID = getImageID();

// Save an exact binary tumor mask for audit and for deterministic centroid,
// vessel-overlap and perivascular-boundary calculations.
tumorMaskTitle = safeID + "_Tumor_mask";
newImage(tumorMaskTitle, "8-bit black", imageWidth, imageHeight, 1);
setVoxelSize(pixelWidth, pixelHeight, 1, lengthUnit);
tumorMaskID = getImageID();
saveSettings();
setForegroundColor(255, 255, 255);
setBackgroundColor(0, 0, 0);
roiManager("select", tumorIndex);
run("Fill");
restoreSettings();
run("Select None");
saveAs("Tiff", tumorMaskPath);

// Measure pooled IgG background only from rectangles fully inside the saved
// tumor ROI. Each temporary rectangle is checked against the tumor mask.
backgroundPixels = 0;
backgroundSum = 0;
if (measureBackground) {
    // Display the tumor boundary as a non-active overlay. Keeping it as the
    // active selection would cause a drag inside the tumor to move the tumor
    // ROI instead of drawing a new background rectangle.
    selectWindow(iggImageTitle);
    roiManager("select", tumorIndex);
    Overlay.addSelection("yellow", 1);
    run("Select None");

    for (b = 0; b < nBackgroundROIs; b++) {
        selectWindow(iggImageTitle);
        run("Select None");
        setTool("rectangle");
        waitForUser("Select intratumoral IgG background ROI " + (b + 1) + " of " + nBackgroundROIs,
            "The yellow outline is the saved tumor ROI. On the ORIGINAL IgG image,\n" +
            "draw a reasonably large background rectangle entirely inside it.\n\n" +
            "Avoid vessels, obvious IgG leakage and tissue-free space. Use\n" +
            "non-overlapping regions distributed across the tumor.\n\n" +
            "Click OK here after drawing the rectangle.");

        st = selectionType;
        if (st != 0)
            exit("Each IgG background selection must be a rectangular area ROI.");

        roiManager("add");
        backgroundIndex = roiManager("count") - 1;
        selectImage(tumorMaskID);
        roiManager("select", backgroundIndex);
        getRawStatistics(bgTumorN, bgTumorMean, bgTumorMin, bgTumorMax);
        if (bgTumorN <= 0 || bgTumorMin != 255 || bgTumorMax != 255) {
            roiManager("select", backgroundIndex);
            roiManager("delete");
            exit("IgG background ROI " + (b + 1) + " is not fully inside the tumor ROI. Run the macro again and redraw it inside the yellow boundary.");
        }

        selectWindow(iggImageTitle);
        roiManager("select", backgroundIndex);
        getRawStatistics(bgN, bgMean);
        if (bgN <= 0) {
            roiManager("select", backgroundIndex);
            roiManager("delete");
            exit("An IgG background ROI contained no pixels.");
        }
        backgroundPixels = backgroundPixels + bgN;
        backgroundSum = backgroundSum + bgN * bgMean;
        roiManager("select", backgroundIndex);
        roiManager("delete");
    }
    backgroundMean = backgroundSum / backgroundPixels;
} else {
    backgroundMean = 0;
}

selectWindow(vesselImageTitle);
vesselImageID = getImageID();
selectWindow(iggImageTitle);
iggImageID = getImageID();
getRawStatistics(iggAllN, iggAllMean, iggAllMin, iggAllMax, iggAllSD);
if (classifyLeakage && iggPositiveThreshold > iggAllMax)
    exit("The fixed IgG-positive threshold is greater than the maximum raw IgG value (" + iggAllMax + ").");
selectWindow(vesselMaskTitle);
vesselMaskID = getImageID();

// Create a fixed IgG-positive mask once, if classification is requested.
iggPositiveMaskID = 0;
if (classifyLeakage) {
    selectWindow(iggImageTitle);
    run("Duplicate...", "title=[" + safeID + "_IgG_positive_mask_working]");
    iggPositiveMaskID = getImageID();
    setThreshold(iggPositiveThreshold, iggAllMax, "raw");
    saveSettings();
    setOption("BlackBackground", true);
    run("Convert to Mask");
    restoreSettings();
}

// Build a second mask in which each vessel lumen is filled independently.
// Independent filling avoids incorrectly filling large tissue spaces enclosed
// by a connected vascular network.
filledMaskTitle = safeID + "_Filled_vessel_exclusion_mask";
newImage(filledMaskTitle, "8-bit black", imageWidth, imageHeight, 1);
setVoxelSize(pixelWidth, pixelHeight, 1, lengthUnit);
filledMaskID = getImageID();
saveSettings();
setForegroundColor(255, 255, 255);
setBackgroundColor(0, 0, 0);

setBatchMode(true);
showStatus("Building lumen-filled vessel boundaries...");

for (i = 0; i < nVessels; i++) {
    showProgress(i + 1, nVessels);
    selectImage(vesselMaskID);
    roiManager("select", i);
    getSelectionBounds(boxX, boxY, boxW, boxH);

    // A two-pixel border ensures that genuine interior holes are separated
    // from the temporary image edge whenever the source vessel is not at the
    // crop boundary.
    localPad = 2;
    localX0 = maxOf(0, boxX - localPad);
    localY0 = maxOf(0, boxY - localPad);
    localX1 = minOf(imageWidth, boxX + boxW + localPad);
    localY1 = minOf(imageHeight, boxY + boxH + localPad);
    localW = localX1 - localX0;
    localH = localY1 - localY0;

    tempTitle = "__PV_FILL_" + i;
    newImage(tempTitle, "8-bit black", localW, localH, 1);
    setVoxelSize(pixelWidth, pixelHeight, 1, lengthUnit);

    // Render the exact saved ROI directly on a small blank image. ImageJ may
    // automatically center a full-image ROI when it is selected on a smaller
    // image, especially for vessels touching an image edge. Correct that
    // automatic placement explicitly using the known full-image bounds.
    roiManager("select", i);
    getSelectionBounds(autoX, autoY, autoW, autoH);
    targetLocalX = boxX - localX0;
    targetLocalY = boxY - localY0;
    Roi.translate(targetLocalX - autoX, targetLocalY - autoY);
    getSelectionBounds(checkLocalX, checkLocalY, checkLocalW, checkLocalH);
    if (checkLocalX < 0 || checkLocalY < 0 || checkLocalX + checkLocalW > localW || checkLocalY + checkLocalH > localH) {
        setBatchMode(false);
        exit("Could not map " + vesselIDs[i] + " into its temporary filling image. No measurements were produced.");
    }
    setForegroundColor(255, 255, 255);
    setBackgroundColor(0, 0, 0);
    run("Fill");
    run("Select None");
    run("Fill Holes");
    setThreshold(255, 255, "raw");
    run("Create Selection");
    if (selectionType < 0) {
        setBatchMode(false);
        exit("Could not create the filled outer boundary for " + vesselIDs[i] + ".");
    }

    getRawStatistics(filledPixels);
    filledProfilePixels[i] = filledPixels;
    Roi.translate(localX0, localY0);
    roiManager("add");
    filledIndex = nVessels + 1 + i;
    roiManager("select", filledIndex);
    roiManager("rename", "__FILLED_" + vesselIDs[i]);

    close();
    selectImage(filledMaskID);
    roiManager("select", filledIndex);
    run("Fill");
}

restoreSettings();
selectImage(filledMaskID);
run("Select None");
saveAs("Tiff", filledMaskPath);

// Convert the union of independently filled vessel profiles into one exact
// exclusion ROI. This removes vessel walls and lumens from every IgG band.
setThreshold(255, 255, "raw");
run("Create Selection");
if (selectionType < 0) {
    setBatchMode(false);
    exit("The filled vessel exclusion mask is empty.");
}
roiManager("add");
globalFilledIndex = 2 * nVessels + 1;
roiManager("select", globalFilledIndex);
roiManager("rename", "__ALL_FILLED_VESSELS__");

resultsTitle = safeID + "_Perivascular_IgG_Results";
Table.create(resultsTitle);

leakyText = "Sample_ID\tVessel_ID\n";
nonleakyText = "Sample_ID\tVessel_ID\n";
excludedText = "Sample_ID\tVessel_ID\tReason\n";
leakyCount = 0;
nonleakyCount = 0;
excludedCount = 0;
validRingCount = 0;
intratumorVesselCount = 0;
outsideTumorVesselCount = 0;
tumorBoundaryTruncatedCount = 0;

showStatus("Measuring perivascular IgG...");

for (i = 0; i < nVessels; i++) {
    showProgress(i + 1, nVessels);
    vesselID = vesselIDs[i];
    filledIndex = nVessels + 1 + i;

    // Geometry of the original marker-positive vessel profile.
    selectImage(vesselImageID);
    roiManager("select", i);
    getRawStatistics(vesselPixels, vesselMean, vesselMin, vesselMax, vesselSD);
    centroidX = getValue("X raw");
    centroidY = getValue("Y raw");
    getSelectionBounds(vesselBoxX, vesselBoxY, vesselBoxW, vesselBoxH);
    vesselAreaCalibrated = vesselPixels * pixelWidth * pixelHeight;
    filledOuterPixels = filledProfilePixels[i];
    filledOuterAreaCalibrated = filledOuterPixels * pixelWidth * pixelHeight;
    enclosedLumenPixels = filledOuterPixels - vesselPixels;
    if (enclosedLumenPixels < 0)
        enclosedLumenPixels = 0;
    enclosedLumenAreaCalibrated = enclosedLumenPixels * pixelWidth * pixelHeight;
    centroidXs[i] = centroidX;
    centroidYs[i] = centroidY;

    // Assign vessels to tumor using the original vessel-profile centroid and
    // quantify how much of the marker-positive vessel lies inside the tumor.
    selectImage(tumorMaskID);
    roiManager("select", i);
    getRawStatistics(vesselTumorN, vesselTumorMean);
    vesselInsideTumorPixels = round(vesselTumorN * vesselTumorMean / 255);
    if (vesselPixels > 0)
        vesselInsideTumorFraction = 100 * vesselInsideTumorPixels / vesselPixels;
    else
        vesselInsideTumorFraction = 0;
    centroidPixelX = floor(centroidX);
    centroidPixelY = floor(centroidY);
    if (centroidPixelX < 0)
        centroidPixelX = 0;
    if (centroidPixelY < 0)
        centroidPixelY = 0;
    if (centroidPixelX >= imageWidth)
        centroidPixelX = imageWidth - 1;
    if (centroidPixelY >= imageHeight)
        centroidPixelY = imageHeight - 1;
    centroidInTumor = 0;
    if (getPixel(centroidPixelX, centroidPixelY) == 255)
        centroidInTumor = 1;

    ringIndex = -1;
    candidatePixels = NaN;
    preTumorClipPixels = NaN;
    ringPixels = 0;
    ringAreaCalibrated = 0;
    excludedVesselPixels = NaN;
    excludedVesselFraction = NaN;
    tumorExcludedPixels = NaN;
    tumorRetainedFraction = NaN;
    edgeTruncated = 0;
    tumorBoundaryTruncated = 0;
    iggMean = NaN;
    iggMin = NaN;
    iggMax = NaN;
    iggSD = NaN;
    rawIntDen = NaN;
    correctedMean = NaN;
    correctedIntDen = NaN;
    positivePixels = NaN;
    positiveArea = NaN;
    positiveFraction = NaN;
    qcStatus = "Excluded_vessel_centroid_outside_tumor";
    leakageStatus = "Excluded_outside_tumor_ROI";
    ringROIName = "";

    if (centroidInTumor) {
        intratumorVesselCount++;

        // Construct a band outside the hole-filled vessel boundary.
        selectImage(vesselImageID);
        roiManager("select", filledIndex);
        getSelectionBounds(filledBoxX, filledBoxY, filledBoxW, filledBoxH);
        if (filledBoxX - outerPixels < 0)
            edgeTruncated = 1;
        if (filledBoxY - outerPixels < 0)
            edgeTruncated = 1;
        if (filledBoxX + filledBoxW + outerPixels > imageWidth)
            edgeTruncated = 1;
        if (filledBoxY + filledBoxH + outerPixels > imageHeight)
            edgeTruncated = 1;

        if (innerPixels > 0)
            run("Enlarge...", "enlarge=" + innerPixels);
        run("Make Band...", "band=" + bandPixels);
        if (selectionType < 0) {
            setBatchMode(false);
            exit("Could not construct a perivascular band for " + vesselID + ".");
        }

        getRawStatistics(candidatePixels);
        roiManager("add");
        candidateIndex = roiManager("count") - 1;
        roiManager("select", candidateIndex);
        roiManager("rename", "__CANDIDATE_" + vesselID);

        // Remove every lumen-filled vascular profile from the candidate band.
        pair = newArray(candidateIndex, globalFilledIndex);
        roiManager("select", pair);
        roiManager("and");

        if (selectionType < 0) {
            // No vascular overlap: the candidate proceeds to tumor clipping.
            ringIndex = candidateIndex;
        } else {
            roiManager("add");
            intersectionIndex = roiManager("count") - 1;
            differencePair = newArray(candidateIndex, intersectionIndex);
            roiManager("select", differencePair);
            roiManager("xor");

            differenceExists = false;
            if (selectionType >= 0) {
                differenceExists = true;
                roiManager("add");
            }

            deletePair = newArray(candidateIndex, intersectionIndex);
            roiManager("select", deletePair);
            roiManager("delete");

            if (differenceExists)
                ringIndex = roiManager("count") - 1;
        }

        // Intersect the vessel-excluded band with the exact user-drawn tumor
        // ROI. Preserve the pre-clipping area so boundary loss is auditable.
        if (ringIndex >= 0) {
            selectImage(tumorMaskID);
            roiManager("select", ringIndex);
            getRawStatistics(preTumorClipPixels);
            excludedVesselPixels = candidatePixels - preTumorClipPixels;
            if (excludedVesselPixels < 0)
                excludedVesselPixels = 0;
            if (candidatePixels > 0)
                excludedVesselFraction = 100 * excludedVesselPixels / candidatePixels;
            else
                excludedVesselFraction = 0;

            tumorPair = newArray(ringIndex, tumorIndex);
            roiManager("select", tumorPair);
            roiManager("and");
            if (selectionType < 0) {
                roiManager("select", ringIndex);
                roiManager("delete");
                ringIndex = -1;
                tumorExcludedPixels = preTumorClipPixels;
                tumorRetainedFraction = 0;
                tumorBoundaryTruncated = 1;
            } else {
                roiManager("add");
                clippedIndex = roiManager("count") - 1;
                roiManager("select", ringIndex);
                roiManager("delete");
                ringIndex = roiManager("count") - 1;

                selectImage(tumorMaskID);
                roiManager("select", ringIndex);
                getRawStatistics(ringPixels);
                tumorExcludedPixels = preTumorClipPixels - ringPixels;
                if (tumorExcludedPixels < 0)
                    tumorExcludedPixels = 0;
                if (preTumorClipPixels > 0)
                    tumorRetainedFraction = 100 * ringPixels / preTumorClipPixels;
                else
                    tumorRetainedFraction = 0;
                if (tumorExcludedPixels > 0)
                    tumorBoundaryTruncated = 1;
            }
        }

        if (tumorBoundaryTruncated)
            tumorBoundaryTruncatedCount++;

        if (ringIndex >= 0) {
            selectImage(iggImageID);
            roiManager("select", ringIndex);
            getRawStatistics(ringPixels, iggMean, iggMin, iggMax, iggSD);
            ringAreaCalibrated = ringPixels * pixelWidth * pixelHeight;

            rawIntDen = ringPixels * iggMean;
            correctedMean = iggMean - backgroundMean;
            correctedIntDen = ringPixels * correctedMean;

            if (classifyLeakage) {
                selectImage(iggPositiveMaskID);
                roiManager("select", ringIndex);
                getRawStatistics(positiveMaskN, positiveMaskMean);
                positivePixels = round(positiveMaskN * positiveMaskMean / 255);
                positiveArea = positivePixels * pixelWidth * pixelHeight;
                if (ringPixels > 0)
                    positiveFraction = 100 * positivePixels / ringPixels;
                else
                    positiveFraction = NaN;
            }

            qcStatus = "Analyzable";
            if (ringAreaCalibrated < minAnalyzableArea)
                qcStatus = "Excluded_small_perivascular_area";
            if (tumorBoundaryTruncated && excludeTumorBoundaryFromClassification)
                qcStatus = "Excluded_tumor_boundary_truncated";
            if (edgeTruncated && excludeEdgeFromClassification)
                qcStatus = "Excluded_edge_truncated";

            if (!classifyLeakage) {
                leakageStatus = "Not_classified";
            } else if (qcStatus != "Analyzable") {
                leakageStatus = qcStatus;
                excludedCount++;
                excludedText = excludedText + sampleID + "\t" + vesselID + "\t" + qcStatus + "\n";
            } else if (positiveFraction >= positiveFractionCutoff) {
                leakageStatus = "Leaky";
                leakyCount++;
                leakyText = leakyText + sampleID + "\t" + vesselID + "\n";
            } else {
                leakageStatus = "Non_leaky";
                nonleakyCount++;
                nonleakyText = nonleakyText + sampleID + "\t" + vesselID + "\n";
            }

            ringROIName = vesselID + "_PV_" + d2s(actualInnerDistance, 2) + "to" + d2s(actualOuterDistance, 2) + safeLabel(lengthUnit) + "_" + leakageStatus;
            roiManager("select", ringIndex);
            roiManager("rename", ringROIName);
            validRingCount++;
        } else {
            qcStatus = "No_perivascular_pixels_inside_tumor";
            leakageStatus = "Excluded_no_perivascular_pixels_inside_tumor";
            if (classifyLeakage) {
                excludedCount++;
                excludedText = excludedText + sampleID + "\t" + vesselID + "\t" + qcStatus + "\n";
            }
        }
    } else {
        outsideTumorVesselCount++;
        if (classifyLeakage) {
            excludedCount++;
            excludedText = excludedText + sampleID + "\t" + vesselID + "\t" + qcStatus + "\n";
        }
    }

    ringIndexes[i] = ringIndex;
    leakStatuses[i] = leakageStatus;
    qcStatuses[i] = qcStatus;

    Table.set("Sample_ID", i, sampleID, resultsTitle);
    Table.set("Vessel_ID", i, vesselID, resultsTitle);
    Table.set("Perivascular_ROI_name", i, ringROIName, resultsTitle);
    Table.set("Crop_origin_X_full_px", i, cropX, resultsTitle);
    Table.set("Crop_origin_Y_full_px", i, cropY, resultsTitle);
    Table.set("Centroid_X_local_px", i, centroidX, resultsTitle);
    Table.set("Centroid_Y_local_px", i, centroidY, resultsTitle);
    Table.set("Centroid_X_full_px", i, cropX + centroidX, resultsTitle);
    Table.set("Centroid_Y_full_px", i, cropY + centroidY, resultsTitle);
    Table.set("Vessel_area_px2", i, vesselPixels, resultsTitle);
    Table.set("Vessel_area_calibrated", i, vesselAreaCalibrated, resultsTitle);
    Table.set("Vessel_centroid_inside_tumor_ROI", i, centroidInTumor, resultsTitle);
    Table.set("Vessel_area_inside_tumor_px2", i, vesselInsideTumorPixels, resultsTitle);
    Table.set("Vessel_area_inside_tumor_pct", i, vesselInsideTumorFraction, resultsTitle);
    Table.set("Filled_outer_profile_area_px2", i, filledOuterPixels, resultsTitle);
    Table.set("Filled_outer_profile_area_calibrated", i, filledOuterAreaCalibrated, resultsTitle);
    Table.set("Enclosed_lumen_area_px2", i, enclosedLumenPixels, resultsTitle);
    Table.set("Enclosed_lumen_area_calibrated", i, enclosedLumenAreaCalibrated, resultsTitle);
    Table.set("Length_unit", i, lengthUnit, resultsTitle);
    Table.set("PV_inner_requested", i, innerDistance, resultsTitle);
    Table.set("PV_outer_requested", i, outerDistance, resultsTitle);
    Table.set("PV_inner_actual", i, actualInnerDistance, resultsTitle);
    Table.set("PV_outer_actual", i, actualOuterDistance, resultsTitle);
    Table.set("PV_inner_px", i, innerPixels, resultsTitle);
    Table.set("PV_outer_px", i, outerPixels, resultsTitle);
    Table.set("PV_candidate_area_px2", i, candidatePixels, resultsTitle);
    Table.set("PV_after_other_vessel_exclusion_px2", i, preTumorClipPixels, resultsTitle);
    Table.set("PV_analyzable_area_px2", i, ringPixels, resultsTitle);
    Table.set("PV_analyzable_area_calibrated", i, ringAreaCalibrated, resultsTitle);
    Table.set("Other_vessel_area_excluded_px2", i, excludedVesselPixels, resultsTitle);
    Table.set("Other_vessel_area_excluded_pct", i, excludedVesselFraction, resultsTitle);
    Table.set("PV_tumor_boundary_excluded_px2", i, tumorExcludedPixels, resultsTitle);
    Table.set("PV_retained_inside_tumor_pct", i, tumorRetainedFraction, resultsTitle);
    Table.set("PV_tumor_boundary_truncated", i, tumorBoundaryTruncated, resultsTitle);
    Table.set("PV_edge_truncated", i, edgeTruncated, resultsTitle);
    Table.set("PV_QC_status", i, qcStatus, resultsTitle);
    Table.set("IgG_PV_Mean_raw", i, iggMean, resultsTitle);
    Table.set("IgG_PV_SD_raw", i, iggSD, resultsTitle);
    Table.set("IgG_PV_Min_raw", i, iggMin, resultsTitle);
    Table.set("IgG_PV_Max_raw", i, iggMax, resultsTitle);
    Table.set("IgG_PV_RawIntDen", i, rawIntDen, resultsTitle);
    Table.set("IgG_background_mean", i, backgroundMean, resultsTitle);
    Table.set("IgG_PV_Mean_bg_corrected", i, correctedMean, resultsTitle);
    Table.set("IgG_PV_CorrectedIntDen", i, correctedIntDen, resultsTitle);
    classificationThresholdOutput = NaN;
    if (classifyLeakage)
        classificationThresholdOutput = iggPositiveThreshold;
    Table.set("IgG_positive_threshold_raw", i, classificationThresholdOutput, resultsTitle);
    Table.set("IgG_PV_positive_pixels", i, positivePixels, resultsTitle);
    Table.set("IgG_PV_positive_area_calibrated", i, positiveArea, resultsTitle);
    Table.set("IgG_PV_positive_area_fraction_pct", i, positiveFraction, resultsTitle);
    Table.set("Leakage_status", i, leakageStatus, resultsTitle);
}

selectWindow(resultsTitle);
Table.update;
Table.save(resultsPath);

// Remove original and temporary filled-vessel ROIs, leaving only the exact
// final perivascular ROIs in ROI Manager for inspection and saving.
removeCount = 2 * nVessels + 2;
removeIndexes = newArray(removeCount);
for (i = 0; i < removeCount; i++)
    removeIndexes[i] = i;
roiManager("select", removeIndexes);
roiManager("delete");

if (roiManager("count") != validRingCount) {
    setBatchMode(false);
    exit("The final perivascular ROI count changed unexpectedly before saving.");
}
if (validRingCount == 0) {
    setBatchMode(false);
    exit("No analyzable perivascular ROIs were generated.");
}

roiManager("remove slice info");
roiManager("save", ringRoiPath);

if (classifyLeakage) {
    File.saveString(leakyText, leakyIDsPath);
    File.saveString(nonleakyText, nonleakyIDsPath);
    File.saveString(excludedText, excludedIDsPath);
}

settingsText =
    "Macro_name=COMET_Perivascular_IgG_Leakage_Quantification\n" +
    "Macro_version=1.1.4\n" +
    "ImageJ_version=" + getVersion() + "\n" +
    "Sample_ID=" + sampleID + "\n" +
    "Vessel_ROI_ZIP=" + roiZipPath + "\n" +
    "Vessel_marker_image=" + vesselImageTitle + "\n" +
    "IgG_image=" + iggImageTitle + "\n" +
    "DAPI_image=" + dapiImageTitle + "\n" +
    "Input_vessel_binary_mask=" + vesselMaskTitle + "\n" +
    "Saved_tumor_ROI=" + tumorRoiPath + "\n" +
    "Saved_tumor_mask=" + tumorMaskPath + "\n" +
    "Tumor_area_px2=" + tumorPixels + "\n" +
    "Tumor_area_calibrated=" + tumorAreaCalibrated + "\n" +
    "Crop_width_px=" + imageWidth + "\n" +
    "Crop_height_px=" + imageHeight + "\n" +
    "Crop_origin_X_full_px=" + cropX + "\n" +
    "Crop_origin_Y_full_px=" + cropY + "\n" +
    "Pixel_width=" + pixelWidth + "\n" +
    "Pixel_height=" + pixelHeight + "\n" +
    "Length_unit=" + lengthUnit + "\n" +
    "Vessel_bit_depth=" + vesselBitDepth + "\n" +
    "IgG_bit_depth=" + iggBitDepth + "\n" +
    "DAPI_bit_depth=" + dapiBitDepth + "\n" +
    "Input_vessel_count=" + nVessels + "\n" +
    "Vessels_with_centroid_inside_tumor=" + intratumorVesselCount + "\n" +
    "Vessels_with_centroid_outside_tumor=" + outsideTumorVesselCount + "\n" +
    "Tumor_boundary_truncated_PV_count=" + tumorBoundaryTruncatedCount + "\n" +
    "Valid_perivascular_ROI_count=" + validRingCount + "\n" +
    "PV_inner_requested=" + innerDistance + "\n" +
    "PV_outer_requested=" + outerDistance + "\n" +
    "PV_inner_actual=" + actualInnerDistance + "\n" +
    "PV_outer_actual=" + actualOuterDistance + "\n" +
    "PV_inner_pixels=" + innerPixels + "\n" +
    "PV_outer_pixels=" + outerPixels + "\n" +
    "Minimum_analyzable_PV_area=" + minAnalyzableArea + "\n" +
    "Exclude_edge_truncated_from_classification=" + excludeEdgeFromClassification + "\n" +
    "Exclude_tumor_boundary_truncated_from_classification=" + excludeTumorBoundaryFromClassification + "\n" +
    "Background_ROI_used=" + measureBackground + "\n" +
    "Number_of_background_ROIs=" + nBackgroundROIs + "\n" +
    "IgG_background_mean_raw=" + backgroundMean + "\n" +
    "Classification_mode=" + classificationMode + "\n" +
    "IgG_positive_threshold_raw=" + iggPositiveThreshold + "\n" +
    "IgG_positive_area_fraction_cutoff_pct=" + positiveFractionCutoff + "\n" +
    "Leaky_count=" + leakyCount + "\n" +
    "Non_leaky_count=" + nonleakyCount + "\n" +
    "Excluded_count=" + excludedCount + "\n" +
    "Tumor_assignment_rule=Vessel centroid must lie inside the user-drawn DAPI tumor ROI.\n" +
    "Tumor_clipping_rule=Each vessel-excluded perivascular band is intersected with the user-drawn DAPI tumor ROI before IgG measurement.\n" +
    "Perivascular_definition=Band from the hole-filled outer boundary of each original V#### vessel ROI.\n" +
    "Lumen_handling=The lumen of each source vessel is filled only to define its outer boundary; the filled vessel is excluded from the perivascular measurement.\n" +
    "Other_vessel_handling=All independently hole-filled vascular profiles, including their lumens, are removed from every perivascular ROI.\n" +
    "Open_wall_caveat=A lumen is filled only when it is enclosed by the source 2D ROI; open or discontinuous vascular walls require biological QC.\n" +
    "Classification_definition=Leaky if analyzable and IgG-positive area fraction is greater than or equal to the fixed cutoff; otherwise Non_leaky.\n" +
    "Overlap_caveat=Perivascular ROIs from nearby vessels may overlap, so shared extravascular pixels can contribute to more than one vessel.\n";

File.saveString(settingsText, settingsPath);

if (classifyLeakage) {
    if (isOpen(iggPositiveMaskID)) {
        selectImage(iggPositiveMaskID);
        close();
    }
}

setBatchMode(false);
selectWindow(iggImageTitle);
run("Select None");
showProgress(1, 1);
showStatus("Perivascular IgG analysis complete");

completionText =
    d2s(nVessels, 0) + " vessel IDs were checked. " + d2s(intratumorVesselCount, 0) +
    " had centroids inside the DAPI tumor ROI; " + d2s(outsideTumorVesselCount, 0) +
    " were excluded as outside tumor.\n" + d2s(validRingCount, 0) +
    " tumor-confined perivascular ROIs were saved.\n\n" +
    "Primary continuous measurements:\n" +
    "- IgG_PV_Mean_bg_corrected\n" +
    "- IgG_PV_positive_area_fraction_pct (classification mode)\n\n" +
    "The saved tumor ROI and tumor mask document the analyzed tissue area.\n" +
    "The ROI Manager now contains the tumor-confined perivascular ROIs. Their names begin with the original V#### ID, allowing direct lookup on the IgG image.";

if (classifyLeakage)
    completionText = completionText + "\n\nLeaky=" + d2s(leakyCount, 0) + "; Non-leaky=" + d2s(nonleakyCount, 0) + "; Excluded=" + d2s(excludedCount, 0) + ".";

showMessage("Perivascular IgG analysis complete", completionText);

function normalizeLengthUnit(unitText) {
    normalized = toLowerCase(String.trim(unitText));
    normalized = replace(normalized, "µ", "u");
    normalized = replace(normalized, "μ", "u");
    canonicalUnit = normalized;
    if (normalized == "um")
        canonicalUnit = "micron";
    if (normalized == "micron")
        canonicalUnit = "micron";
    if (normalized == "microns")
        canonicalUnit = "micron";
    if (normalized == "micrometer")
        canonicalUnit = "micron";
    if (normalized == "micrometers")
        canonicalUnit = "micron";
    if (normalized == "pixel")
        canonicalUnit = "pixel";
    if (normalized == "pixels")
        canonicalUnit = "pixel";
    if (normalized == "pix")
        canonicalUnit = "pixel";
    if (normalized == "nm")
        canonicalUnit = "nanometer";
    if (normalized == "nanometer")
        canonicalUnit = "nanometer";
    if (normalized == "nanometers")
        canonicalUnit = "nanometer";
    if (normalized == "mm")
        canonicalUnit = "millimeter";
    if (normalized == "millimeter")
        canonicalUnit = "millimeter";
    if (normalized == "millimeters")
        canonicalUnit = "millimeter";
    return canonicalUnit;
}

function safeLabel(s) {
    s = replace(s, " ", "_");
    s = replace(s, "/", "_");
    s = replace(s, "\\", "_");
    s = replace(s, ":", "_");
    s = replace(s, ";", "_");
    s = replace(s, ",", "_");
    s = replace(s, "*", "_");
    s = replace(s, "?", "_");
    s = replace(s, "\"", "_");
    s = replace(s, "'", "_");
    s = replace(s, "<", "_");
    s = replace(s, ">", "_");
    s = replace(s, "|", "_");
    s = replace(s, "[", "_");
    s = replace(s, "]", "_");
    s = replace(s, "(", "_");
    s = replace(s, ")", "_");
    s = replace(s, "{", "_");
    s = replace(s, "}", "_");
    s = replace(s, "=", "_");
    s = replace(s, "+", "_");
    s = replace(s, "-", "_");
    s = replace(s, ".", "_");
    s = replace(s, "\t", "_");
    s = replace(s, "\r", "_");
    s = replace(s, "\n", "_");
    return s;
}
